# GLaDOS check-in config — copy to ".env" in this same directory and fill in.
# The real .env holds your account cookie: keep it chmod 600, never share it.

# REQUIRED — your GLaDOS session cookie.
# How to get it: log in first (https://glados.cloud/login or the Login button
# on railgun.info) — console links bounce to the homepage while signed out.
# Then on any console page press F12 -> Network, refresh, click the first
# request, and copy the "Cookie" request header value.
# Format: koa:sess=xxxx; koa:sess.sig=yyyy;
# Multiple accounts: join several cookies with &  (cookie1&cookie2)
GLADOS_COOKIES=

# OPTIONAL — auto-exchange points for days once the balance reaches the plan:
#   plan100 = 100 points -> 10 days | plan200 = 200 -> 30 | plan500 = 500 -> 100
# Leave empty (or "none") to never auto-exchange.
GLADOS_EXCHANGE_PLAN=

# OPTIONAL — push the result summary to your phone (all configured backends fire):
PUSHDEER_SENDKEY=
SERVERCHAN_SENDKEY=

# OPTIONAL — verbose per-request logging (true/false)
GLADOS_VERBOSE=
