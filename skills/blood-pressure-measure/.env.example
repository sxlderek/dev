# blood-pressure-measure configuration. Copy to .env, fill in, chmod 600 .env
# Real environment variables override these values.

# Path of the CSV database (created with the header row only, see SKILL.md)
BP_CSV_PATH=<HOME>/blood-pressure/blood_pressure_log.csv

# Who receives the database email after each new record
BP_MAIL_TO=<EMAIL>
# Sender address (optional; omit to use the mail account's default)
BP_MAIL_FROM=<EMAIL>
# Subject of the database email
BP_MAIL_SUBJECT=blood-pressure database

# Mail CLI, Himalaya convention: "<cli> message send --account <acct>",
# RFC822 message read from stdin
BP_MAIL_CLI=himalaya
BP_MAIL_ACCOUNT=<ACCOUNT>

# Zip the CSV before sending once it grows past this size
BP_ZIP_THRESHOLD_KB=500

# Daily reminder time (local, 24h) — used when creating the schedule
BP_REMINDER_TIME=11:00
